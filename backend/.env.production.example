# Production environment template.
#
# Copy this to `.env` on the production server (never commit the real `.env`),
# then fill in every value marked CHANGE ME. The defaults below differ from
# `.env.example` specifically where local-dev defaults would be unsafe or
# wrong in production (debug mode, error visibility, real mail/SMS delivery).

APP_NAME="FitHub"
APP_ENV=production
APP_KEY=                       # CHANGE ME — generate with `php artisan key:generate --show`
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://CHANGE-ME.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Errors go to the log + Sentry (below), never to the browser.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fithub             # CHANGE ME
DB_USERNAME=fithub              # CHANGE ME
DB_PASSWORD=                    # CHANGE ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Minutes until a mobile app Sanctum token expires (30 days).
SANCTUM_TOKEN_EXPIRATION=43200

# Get a DSN from sentry.io — error tracking should be on in production.
SENTRY_LARAVEL_DSN=             # CHANGE ME
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.2

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real transactional email — "log" would silently swallow every email sent.
#
# Do NOT point this at a personal Gmail account (smtp.gmail.com). It works for
# local testing but Google rate-limits and flags personal accounts once volume
# picks up (trial reminders, payment-failed notices, verification emails all
# add up fast), and mail from a gmail.com address will not carry FitHub's own
# domain reputation — it's more likely to land in spam either way.
#
# Use a transactional provider instead — Postmark, Amazon SES, Mailgun, or
# Resend all work with Laravel's SMTP driver out of the box. Whichever you
# pick: send from a subdomain of the real FitHub domain (e.g.
# mail.CHANGE-ME.example.com) and add that provider's SPF, DKIM, and DMARC
# DNS records — without them, mail deliverability degrades regardless of
# which provider sends it.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=                      # CHANGE ME — e.g. smtp.postmarkapp.com / email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=                  # CHANGE ME
MAIL_PASSWORD=                  # CHANGE ME
MAIL_FROM_ADDRESS="hello@CHANGE-ME.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shown on the marketing site, legal pages, and suspended-account messaging.
SUPPORT_EMAIL=support@CHANGE-ME.example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Where backup failure/health alerts (spatie/laravel-backup) are emailed.
BACKUP_NOTIFICATION_EMAIL=      # CHANGE ME
BACKUP_ARCHIVE_PASSWORD=        # CHANGE ME

TWILIO_SID=                     # CHANGE ME
TWILIO_AUTH_TOKEN=              # CHANGE ME
TWILIO_FROM_NUMBER=             # CHANGE ME

# Live (not test) Stripe keys — this is what actually charges cards.
STRIPE_KEY=                     # CHANGE ME
STRIPE_SECRET=                  # CHANGE ME
STRIPE_WEBHOOK_SECRET=          # CHANGE ME
CASHIER_CURRENCY=usd

VITE_APP_NAME="${APP_NAME}"
