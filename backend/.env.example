APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Minutes until a mobile app Sanctum token expires (30 days).
SANCTUM_TOKEN_EXPIRATION=43200

# Leave blank to disable error tracking (safe default for local dev).
# Get a DSN from sentry.io once RankSol has a project set up.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.2

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email is sent via Resend (https://resend.com/api-keys). Until a domain is
# verified in the Resend dashboard, MAIL_FROM_ADDRESS must stay
# onboarding@resend.dev (Resend's shared sandbox address) — anything else
# will be rejected by their API.
MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Shown on the marketing site, legal pages, and suspended-account messaging.
SUPPORT_EMAIL=support@example.com

# Shown on the marketing site and used for the floating WhatsApp button.
# E.164 format (with country code, no spaces/dashes) — e.g. +923001234567.
SUPPORT_PHONE=+10000000000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Where backup failure/health alerts (spatie/laravel-backup) are emailed.
BACKUP_NOTIFICATION_EMAIL=
BACKUP_ARCHIVE_PASSWORD=

TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd

VITE_APP_NAME="${APP_NAME}"
